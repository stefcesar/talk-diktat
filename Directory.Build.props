<Project>

  <!-- Gemeinsame Einstellungen für alle Projekte der Solution Talk. -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <Authors>Stefano Cesaretti</Authors>
    <Product>Talk</Product>
    <Version>0.4.1</Version>
    <Copyright>© 2026 Stefano Cesaretti</Copyright>
    <Company>Stefano Cesaretti</Company>
    <Description>Talk – Created by Stefano Cesaretti</Description>
    <NeutralLanguage>de-DE</NeutralLanguage>
  </PropertyGroup>

  <!-- XML Dokumentation nur für die Kernbibliothek, dort sind alle öffentlichen Deklarationen kommentiert. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Talk.Core'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
