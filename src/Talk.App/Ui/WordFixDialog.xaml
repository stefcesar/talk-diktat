<Window x:Class="Talk.App.Ui.WordFixDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Talk.App.Ui"
        Title="{ui:T wordfix.title}"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <!--
      Aus einem Text im Verlauf ein falsch geschriebenes Wort ins Wörterbuch übernehmen (Playbook Abschnitt 27). Jedes Wort ist ein Knopf:
      ein Klick wählt es, ein Klick auf das Nachbarwort nimmt es dazu. Alles mit einzelnen Klicks. Optik nach DESIGN.md wie der Schlüsseldialog.
    -->
    <StackPanel Margin="24,24,24,16">

        <TextBlock Text="{ui:T wordfix.title}" Style="{StaticResource TitleText}" />
        <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0"
                   Text="{ui:T wordfix.intro}" />

        <!-- Ein langer Text wird gerollt, damit "Merken" und "Schließen" immer erreichbar bleiben. -->
        <ScrollViewer MaxHeight="240" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <WrapPanel x:Name="WordsPanel" />
        </ScrollViewer>

        <TextBlock Text="{ui:T wordfix.correct_label}" Style="{StaticResource LabelText}" Margin="0,16,0,8" />
        <TextBox x:Name="CorrectBox" />

        <TextBlock Text="{ui:T wordfix.list.label}" Style="{StaticResource LabelText}" Margin="0,16,0,8" />
        <WrapPanel>
            <RadioButton x:Name="ListPrivate" Content="{ui:T wordfix.list.private}" GroupName="FixList" Style="{StaticResource WordChoiceButton}" IsChecked="True" />
            <RadioButton x:Name="ListGeneral" Content="{ui:T wordfix.list.general}" GroupName="FixList" Style="{StaticResource WordChoiceButton}" />
        </WrapPanel>
        <TextBlock Style="{StaticResource HintText}"
                   Text="{ui:T wordfix.list.hint}" />

        <Button Content="{ui:T wordfix.remember}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,16,0,0" Click="OnRememberClick" />

        <!-- Die letzte Meldung. Ins Protokoll geht nie ein Wort. -->
        <TextBlock x:Name="StatusText" Style="{StaticResource HintText}" MinHeight="40" Margin="0,16,0,0" />

        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="-24,8,-24,0" Padding="24,16,24,0">
            <Button Content="{ui:T common.close}" HorizontalAlignment="Right" IsCancel="True" Click="OnCloseClick" />
        </Border>

    </StackPanel>
</Window>
