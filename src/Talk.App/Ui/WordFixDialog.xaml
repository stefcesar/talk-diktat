<Window x:Class="Talk.App.Ui.WordFixDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wort korrigieren"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <!--
      Aus einem Text im Verlauf ein falsch geschriebenes Wort ins Wörterbuch übernehmen (Playbook Abschnitt 27). Jedes Wort ist ein Knopf:
      ein Klick wählt es, ein Klick auf das Nachbarwort nimmt es dazu. Alles mit einzelnen Klicks. Optik nach DESIGN.md wie der Schlüsseldialog.
    -->
    <StackPanel Margin="24,24,24,16">

        <TextBlock Text="Wort korrigieren" Style="{StaticResource TitleText}" />
        <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0"
                   Text="Klicke auf das Wort, das Talk falsch geschrieben hat. Gehört das Nachbarwort dazu (zum Beispiel &quot;Lumi Ora&quot;), klicke es auch an. Dann das richtige Wort eintragen und merken." />

        <!-- Ein langer Text wird gerollt, damit "Merken" und "Schließen" immer erreichbar bleiben. -->
        <ScrollViewer MaxHeight="240" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <WrapPanel x:Name="WordsPanel" />
        </ScrollViewer>

        <TextBlock Text="Richtig geschrieben" Style="{StaticResource LabelText}" Margin="0,16,0,8" />
        <TextBox x:Name="CorrectBox" />

        <TextBlock Text="Liste" Style="{StaticResource LabelText}" Margin="0,16,0,8" />
        <WrapPanel>
            <RadioButton x:Name="ListPrivate" Content="Privat" GroupName="FixList" Style="{StaticResource WordChoiceButton}" IsChecked="True" />
            <RadioButton x:Name="ListGeneral" Content="Allgemein" GroupName="FixList" Style="{StaticResource WordChoiceButton}" />
        </WrapPanel>
        <TextBlock Style="{StaticResource HintText}"
                   Text="Privat: Namen von Menschen und alles Persönliche, bleibt immer auf diesem Rechner, darum vorgewählt. Allgemein: Marken, Firmen, Orte, Fachwörter, geht auch als Hinweis an Groq." />

        <Button Content="Merken" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,16,0,0" Click="OnRememberClick" />

        <!-- Die letzte Meldung. Ins Protokoll geht nie ein Wort. -->
        <TextBlock x:Name="StatusText" Style="{StaticResource HintText}" MinHeight="40" Margin="0,16,0,0" />

        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="-24,8,-24,0" Padding="24,16,24,0">
            <Button Content="Schließen" HorizontalAlignment="Right" IsCancel="True" Click="OnCloseClick" />
        </Border>

    </StackPanel>
</Window>
