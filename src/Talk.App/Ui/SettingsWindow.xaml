<Window x:Class="Talk.App.Ui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Talk Einstellungen"
        Width="560"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">
    <!--
      Jede Änderung gilt sofort und wird gespeichert. Alles geht mit einzelnen Klicks, auch das Doppeltipp Fenster (feste Werte zur Wahl).
      Optik nach DESIGN.md: Titel, dann Abschnitte mit Überschrift; Schalter mit Text links, Auswahl über die ganze Breite.
    -->
    <DockPanel>

        <!-- Fuß, immer sichtbar, auch wenn oben gerollt wird: die letzte Meldung und "Schließen". -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="0,0,16,0"
                           Text="Jede Änderung gilt sofort und wird gespeichert." />
                <Button Grid.Column="1" Content="Schließen" Click="OnCloseClick" />
            </Grid>
        </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,24,24,24">

            <TextBlock Text="Einstellungen" Style="{StaticResource TitleText}" />

            <!-- Aufnahme -->
            <TextBlock Text="Aufnahme" Style="{StaticResource SectionText}" Margin="0,32,0,8" />
            <TextBlock Text="Mikrofon" Style="{StaticResource LabelText}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="DeviceBox" DisplayMemberPath="Name" SelectionChanged="OnDeviceChanged" />
                <Button Grid.Column="1" Content="Neu laden" Margin="8,0,0,0" Click="OnReloadDevicesClick" />
            </Grid>
            <TextBlock x:Name="DeviceHintText" Style="{StaticResource WarnText}" Visibility="Collapsed" Margin="0,8,0,0" />

            <TextBlock Text="Sprache" Style="{StaticResource LabelText}" Margin="0,16,0,8" />
            <ComboBox x:Name="LanguageBox" SelectionChanged="OnChanged">
                <ComboBoxItem Content="Deutsch" Tag="de" />
                <ComboBoxItem Content="Italienisch" Tag="it" />
                <ComboBoxItem Content="Englisch" Tag="en" />
                <ComboBoxItem Content="Schweizerdeutsch" Tag="de-ch" />
                <ComboBoxItem Content="Mundart" Tag="gsw" />
            </ComboBox>
            <!-- Nur bei Schweizerdeutsch und Mundart sichtbar (Playbook Abschnitt 26). -->
            <TextBlock x:Name="SwissHintText" Style="{StaticResource HintText}" Visibility="Collapsed" Margin="0,8,0,0" />
            <StackPanel x:Name="DialectPanel" Visibility="Collapsed">
                <TextBlock Text="Dialekt" Style="{StaticResource LabelText}" Margin="0,16,0,8" />
                <ComboBox x:Name="DialectBox" SelectionChanged="OnChanged">
                    <ComboBoxItem Content="Zürich" Tag="zh" />
                    <ComboBoxItem Content="Bern" Tag="be" />
                    <ComboBoxItem Content="Basel" Tag="bs" />
                    <ComboBoxItem Content="gemischt" Tag="mix" />
                </ComboBox>
            </StackPanel>

            <!-- Bedienung -->
            <TextBlock Text="Bedienung" Style="{StaticResource SectionText}" Margin="0,32,0,8" />
            <TextBlock Text="Zeit zwischen den beiden Tipps auf ⇧ Caps" Style="{StaticResource LabelText}" />
            <!-- Die Werte baut der Code; ein eigener Wert aus settings.json kommt als weitere Wahl dazu. -->
            <WrapPanel x:Name="DoubleTapPanel" />
            <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,8"
                       Text="In Millisekunden. Größer heißt: Du darfst dir zwischen den beiden Tipps mehr Zeit lassen." />
            <CheckBox x:Name="PushToTalkBox" Content="Push to Talk (⇧ Caps gedrückt halten)" Checked="OnChanged" Unchecked="OnChanged" />

            <!-- Rückmeldung -->
            <TextBlock Text="Rückmeldung" Style="{StaticResource SectionText}" Margin="0,32,0,8" />
            <CheckBox x:Name="SoundsBox" Content="Töne bei Start, Stopp und Abbruch" Checked="OnChanged" Unchecked="OnChanged" />
            <CheckBox x:Name="OverlayBox" Content="Anzeige über der Taskleiste während Aufnahme und Verarbeitung" Checked="OnChanged" Unchecked="OnChanged" />
            <CheckBox x:Name="DuckingBox" Content="Andere Programme während der Aufnahme leiser (Musik, Videos)" Checked="OnChanged" Unchecked="OnChanged" />

            <!-- Text glätten -->
            <TextBlock Text="Text glätten" Style="{StaticResource SectionText}" Margin="0,32,0,8" />
            <CheckBox x:Name="SmoothingBox" Content="Text vor dem Einfügen glätten (geht über Groq ins Internet)" Checked="OnChanged" Unchecked="OnChanged" />
            <TextBlock x:Name="SmoothingHintText" Style="{StaticResource WarnText}" Visibility="Collapsed" Margin="0,0,0,8" />
            <TextBlock Text="Stufe" Style="{StaticResource LabelText}" Margin="0,8,0,8" />
            <ComboBox x:Name="SmoothingLevelBox" SelectionChanged="OnChanged">
                <ComboBoxItem Content="Nur Fehler beheben" Tag="Correct" />
                <ComboBoxItem Content="Sätze glätten" Tag="Smooth" />
                <ComboBoxItem Content="Als Nachricht ausformulieren" Tag="Message" />
            </ComboBox>

            <!-- Eigene Stufe je Zielprogramm (Playbook Abschnitt 23). Die Zeilen baut der Code: gespeicherte zuerst, dann die zuletzt benutzten. -->
            <TextBlock Text="Stufe je Programm" Style="{StaticResource LabelText}" Margin="0,24,0,8" />
            <StackPanel x:Name="PerAppPanel" />
            <TextBlock x:Name="PerAppEmptyText" Style="{StaticResource HintText}"
                       Text="Ein Programm erscheint hier, sobald du einmal hineindiktiert hast." />
            <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0"
                       Text="Gilt nur, wenn Glätten oben an ist. &quot;Wie Standard&quot; nimmt die Stufe oben, &quot;Aus&quot; schaltet die Glättung für dieses Programm ab." />

            <!-- Wörterbuch (Playbook Abschnitt 27): eigene Wörter eintragen und entfernen. Die Liste der Einträge baut der Code. -->
            <TextBlock Text="Wörterbuch" Style="{StaticResource SectionText}" Margin="0,32,0,8" />
            <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,8"
                       Text="Wörter, die Talk falsch schreibt, zum Beispiel Namen oder Fachwörter. Gilt ab dem nächsten Diktat." />
            <TextBlock Text="Liste" Style="{StaticResource LabelText}" />
            <WrapPanel>
                <RadioButton x:Name="WordListPrivate" Content="Privat" GroupName="WordList" Style="{StaticResource WordChoiceButton}" Checked="OnWordListChecked" />
                <RadioButton x:Name="WordListGeneral" Content="Allgemein" GroupName="WordList" Style="{StaticResource WordChoiceButton}" Checked="OnWordListChecked" />
                <RadioButton x:Name="WordListSwiss" Content="Schweiz" GroupName="WordList" Style="{StaticResource WordChoiceButton}" Checked="OnWordListChecked" />
            </WrapPanel>
            <TextBlock x:Name="WordListHintText" Style="{StaticResource HintText}" Margin="0,0,0,16" />
            <TextBlock x:Name="WordTermLabel" Text="Richtiges Wort" Style="{StaticResource LabelText}" />
            <TextBox x:Name="WordTermBox" />
            <TextBlock x:Name="WordVariantsLabel" Text="So schreibt Talk es bisher falsch (freiwillig, mehrere mit Komma)" Style="{StaticResource LabelText}" Margin="0,16,0,8" />
            <TextBox x:Name="WordVariantsBox" />
            <Button Content="Hinzufügen" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,16,0,0" Click="OnWordAddClick" />
            <TextBlock x:Name="WordStatusText" Style="{StaticResource HintText}" Margin="0,8,0,0" Visibility="Collapsed" />
            <StackPanel x:Name="WordEntriesPanel" Margin="0,16,0,0" />
            <TextBlock x:Name="WordEmptyText" Style="{StaticResource HintText}" Text="In dieser Liste stehen noch keine Wörter." />

            <!-- Datenschutz -->
            <TextBlock Text="Datenschutz" Style="{StaticResource SectionText}" Margin="0,32,0,8" />
            <CheckBox x:Name="LocalOnlyBox" Content="Nur lokal (nichts geht ins Internet)" Checked="OnChanged" Unchecked="OnChanged" />
            <CheckBox x:Name="HistoryBox" Content="Verlauf verschlüsselt speichern (30 Tage)" Checked="OnChanged" Unchecked="OnHistoryUnchecked" />
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="KeyStateText" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Groq Schlüssel" Click="OnKeyDialogClick" />
            </Grid>

            <!-- Start -->
            <TextBlock Text="Start" Style="{StaticResource SectionText}" Margin="0,32,0,8" />
            <CheckBox x:Name="AutostartBox" Content="Talk mit Windows starten" Checked="OnAutostartChanged" Unchecked="OnAutostartChanged" />
            <TextBlock x:Name="AutostartHintText" Style="{StaticResource WarnText}" Visibility="Collapsed" />

        </StackPanel>
    </ScrollViewer>

    </DockPanel>
</Window>
