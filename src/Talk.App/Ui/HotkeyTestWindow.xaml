<Window x:Class="Talk.App.Ui.HotkeyTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Talk.App.Ui"
        Title="{ui:T diag.title}"
        Width="520"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        FontSize="14">
    <!-- Diagnosefenster. Es darf Fokus haben, das Overlay nicht. Der Ablauf liegt im DictationCoordinator. -->
    <!-- Das Fenster ist höchstens so hoch wie der Arbeitsbereich des Bildschirms (im Code gesetzt); was nicht passt, wird gerollt. -->
    <!-- Alle Texte kommen aus der Übersetzungstabelle (Playbook Abschnitt 29); was sich ändert, setzt der Code beim Öffnen. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20">

            <TextBlock Text="{ui:T diag.state}" Foreground="{StaticResource TextMutedBrush}" />
            <TextBlock x:Name="StateText" FontSize="40" FontWeight="SemiBold" Margin="0,0,0,16" />

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{ui:T diag.count.start}" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock x:Name="StartCountText" FontSize="24" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{ui:T diag.count.stop}" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock x:Name="StopCountText" FontSize="24" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{ui:T diag.count.cancel}" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock x:Name="CancelCountText" FontSize="24" />
                </StackPanel>
            </Grid>

            <TextBlock x:Name="CapsText" Margin="0,0,0,4" />
            <TextBlock x:Name="HookText" Margin="0,0,0,4" />
            <TextBlock x:Name="ReinstallText" TextWrapping="Wrap" Margin="0,0,0,16" />

            <!-- Schritt 3: Mikrofon, Pegel und Ergebnis der Stilleerkennung. Der Gerätename erscheint nur hier, nie im Protokoll. -->
            <TextBlock Text="{ui:T settings.microphone}" Foreground="{StaticResource TextMutedBrush}" />
            <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                <ComboBox x:Name="DeviceBox"
                          Width="330"
                          DisplayMemberPath="Name"
                          SelectionChanged="OnDeviceChanged" />
                <Button Content="{ui:T settings.devices.reload}" Margin="8,0,0,0" Padding="12,4" Click="OnReloadDevicesClick" />
            </StackPanel>
            <TextBlock x:Name="DeviceHintText"
                       Foreground="{StaticResource WarnBrush}"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"
                       Margin="0,0,0,8" />

            <TextBlock Text="{ui:T diag.level}" Foreground="{StaticResource TextMutedBrush}" />
            <ProgressBar x:Name="LevelBar" Minimum="0" Maximum="100" Value="0" Height="18" Margin="0,2,0,12" />

            <TextBlock Text="{ui:T diag.result}" Foreground="{StaticResource TextMutedBrush}" />
            <TextBlock x:Name="ResultText" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,2,0,16" />

            <!-- Schritt 4: Erkennung. Der erkannte Text erscheint nur hier, nie im Protokoll. Der Schlüssel erscheint nirgends. -->
            <TextBlock Text="{ui:T diag.recognition}" Foreground="{StaticResource TextMutedBrush}" />
            <StackPanel Orientation="Horizontal" Margin="0,2,0,8">
                <Button Content="{ui:T settings.key_button}" Padding="12,6" Click="OnKeyDialogClick" />
                <TextBlock x:Name="KeyStateText" VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>

            <CheckBox x:Name="LocalOnlyBox"
                      Content="{ui:T settings.local_only}"
                      Margin="0,0,0,4"
                      Checked="OnLocalOnlyChanged"
                      Unchecked="OnLocalOnlyChanged" />
            <!-- Zustand des lokalen Modells: lädt beim Öffnen im Hintergrund. Fehlt die Datei, steht hier der Hinweis in Orange. -->
            <TextBlock x:Name="LocalModelText"
                       Foreground="{StaticResource TextMutedBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="{ui:T diag.language}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="LanguageBox" Width="160" SelectedIndex="0" SelectionChanged="OnLanguageChanged">
                    <ComboBoxItem Content="{ui:T lang.de}" Tag="de" />
                    <ComboBoxItem Content="{ui:T lang.it}" Tag="it" />
                    <ComboBoxItem Content="{ui:T lang.en}" Tag="en" />
                    <ComboBoxItem Content="{ui:T lang.de_ch}" Tag="de-ch" />
                    <ComboBoxItem Content="{ui:T lang.gsw}" Tag="gsw" />
                </ComboBox>
            </StackPanel>

            <TextBlock Text="{ui:T diag.vocabulary}" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" />
            <TextBox x:Name="VocabularyBox"
                     TextChanged="OnVocabularyChanged"
                     Margin="0,2,0,8" />

            <TextBlock Text="{ui:T diag.transcript}" Foreground="{StaticResource TextMutedBrush}" />
            <TextBox x:Name="TranscriptBox"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Height="110"
                     Margin="0,2,0,4" />
            <TextBlock x:Name="RawText" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
            <TextBlock x:Name="UnsmoothedText" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
            <TextBlock x:Name="SmoothText" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
            <TextBlock x:Name="SttText" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,2" />
            <TextBlock x:Name="InsertInfoText" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" />
            <Button x:Name="RetryButton"
                    Content="{ui:T diag.retry}"
                    HorizontalAlignment="Left"
                    Padding="12,6"
                    Margin="0,0,0,16"
                    IsEnabled="False"
                    Click="OnRetryClick" />

            <CheckBox x:Name="PushToTalkBox"
                      Content="{ui:T diag.push_to_talk}"
                      Margin="0,0,0,12"
                      Checked="OnOptionsChanged"
                      Unchecked="OnOptionsChanged" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock Text="{ui:T diag.double_tap}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="DoubleTapBox" Width="70" VerticalContentAlignment="Center" />
                <Button Content="{ui:T diag.apply}" Margin="8,0,0,0" Padding="12,4" Click="OnApplyClick" />
            </StackPanel>

            <TextBlock Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"
                       Text="{ui:T diag.help}" />

            <DockPanel Margin="0,16,0,0">
                <Button DockPanel.Dock="Right" Content="{ui:T common.close}" Padding="16,6" Click="OnQuitClick" />
                <Button Content="{ui:T history.heading}" HorizontalAlignment="Left" Padding="16,6" Click="OnHistoryClick" />
            </DockPanel>

        </StackPanel>
    </ScrollViewer>
</Window>
