<Window x:Class="Talk.App.Ui.KeyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Talk.App.Ui"
        Title="{ui:T key.title}"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <!--
      Eingabe des Groq Schlüssels. Das Feld ist verdeckt, es gibt keinen Knopf zum Aufdecken. Jeder Knopf braucht nur einen einzelnen Klick.
      Optik nach DESIGN.md: Titel, Zustand, Feld, Knöpfe in einer Reihe (Speichern als Hauptaktion), Meldung, Fuß mit "Schließen".
    -->
    <StackPanel Margin="24,24,24,16">

        <TextBlock Text="{ui:T key.title}" Style="{StaticResource TitleText}" />
        <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0"
                   Text="{ui:T key.intro}" />

        <TextBlock x:Name="StoredText" Text="{ui:T key.stored.no}" Style="{StaticResource SectionText}" Margin="0,24,0,16" />

        <TextBlock Text="{ui:T key.new_label}" Style="{StaticResource LabelText}" />
        <PasswordBox x:Name="KeyBox" MaxLength="1280" PasswordChanged="OnPasswordChanged" />
        <Button x:Name="PasteButton" Content="{ui:T key.paste}" HorizontalAlignment="Stretch" Margin="0,8,0,0" Click="OnPasteClick" />

        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="SaveButton" Grid.Column="0" Content="{ui:T common.save}" Style="{StaticResource PrimaryButton}" IsEnabled="False" Click="OnSaveClick" />
            <Button x:Name="CheckButton" Grid.Column="2" Content="{ui:T key.check}" Click="OnCheckClick" />
            <Button x:Name="DeleteButton" Grid.Column="4" Content="{ui:T common.delete}" Style="{StaticResource DangerButton}" IsEnabled="False" Click="OnDeleteClick" />
        </Grid>

        <!-- Die letzte Meldung. Sie nennt nie den Schlüssel, nur seine Länge oder das Ergebnis. -->
        <TextBlock x:Name="StatusText" Text="{ui:T key.status.ready}" TextWrapping="Wrap" MinHeight="40" Margin="0,16,0,0" />

        <TextBlock x:Name="LocalOnlyHintText" Style="{StaticResource HintText}" Visibility="Collapsed" Margin="0,0,0,8"
                   Text="{ui:T key.local_only_hint}" />

        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="-24,8,-24,0" Padding="24,16,24,0">
            <Button Content="{ui:T common.close}" HorizontalAlignment="Right" IsCancel="True" Click="OnCloseClick" />
        </Border>

    </StackPanel>
</Window>
